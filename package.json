{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node dist-sim/launcher.js",
    "build": "tsc --noEmit && tsc -p tsconfig.sim.json && vite build",
    "headless": "node dist-sim/headless.js",
    "test": "vitest run",
    "verify:all": "npm run build && npm test",
    "bench": "node dist-sim/bench.js",
    "soak": "node --jitless --no-expose-wasm dist-sim/soak.js"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/three": "0.170.0",
    "playwright": "1.56.1",
    "typescript": "5.7.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
